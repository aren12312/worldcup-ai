# Backend — use the same names as GitHub Secrets
FOOTBALL_DATA_API_KEY=       # football-data.org (already in your GitHub Secrets)
TELEGRAM_BOT_TOKEN=          # from @BotFather (already in your GitHub Secrets)
ODDS_API_KEY=                # the-odds-api.com (already in your GitHub Secrets)
WEATHER_API_KEY=             # openweathermap.org (already in your GitHub Secrets)
OPENAI_API_KEY=              # optional — richer AI narrative
OPENAI_MODEL=gpt-4o-mini
PUBLIC_BASE_URL=             # auto-set on Cloud Run deploy

# Optional fallback
API_FOOTBALL_KEY=            # api-football.com if you also have this key

# Local dev
API_URL=http://localhost:8080
