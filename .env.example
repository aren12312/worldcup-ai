# Backend — use the same names as GitHub Secrets
TELEGRAM_BOT_USERNAME=WorldCupApi
TELEGRAM_BOT_TOKEN=              # full token from @BotFather
TELEGRAM_CHAT_ID=                # your chat id (GitHub secret: CHAT_ID)
FOOTBALL_DATA_API_KEY=           # football-data.org
ODDS_API_KEY=                    # the-odds-api.com
WEATHER_API_KEY=                 # openweathermap.org
OPENAI_API_KEY=                  # optional
OPENAI_MODEL=gpt-4o-mini
PUBLIC_BASE_URL=                 # auto-set on Cloud Run deploy

# Optional fallback
API_FOOTBALL_KEY=            # api-football.com if you also have this key

# Local dev
API_URL=http://localhost:8080
